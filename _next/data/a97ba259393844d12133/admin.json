{"pageProps":{"body":"\n  <div class=\"shell\">\n    <aside class=\"sidebar\">\n      <a class=\"brand\" href=\"../\"><img src=\"../logo-light.png\" alt=\"CloudEmpire\"></a>\n      <span class=\"side-label\">CONTROL CENTER</span>\n      <nav aria-label=\"Admin sections\">\n        <button type=\"button\" data-tab=\"overview\" class=\"active\">Dashboard</button>\n        <button type=\"button\" data-tab=\"articles\">Blog posts</button>\n        <button type=\"button\" data-tab=\"services\">Services</button>\n        <button type=\"button\" data-tab=\"projects\">Portfolio</button>\n        <button type=\"button\" data-tab=\"processSteps\">Process</button>\n        <button type=\"button\" data-tab=\"messages\">Inquiries</button>\n        <button type=\"button\" data-tab=\"analytics\">Analytics</button>\n        <button type=\"button\" data-tab=\"utm\">UTM campaigns</button>\n        <button type=\"button\" data-tab=\"database\" data-owner-only>Database & media</button>\n        <button type=\"button\" data-tab=\"users\" data-owner-only>Admin users</button>\n        <button type=\"button\" data-tab=\"files\">Site copy</button>\n      </nav>\n      <div class=\"side-bottom\"><a href=\"../\" target=\"_blank\" rel=\"noopener\">View website ↗</a><button id=\"logout\" type=\"button\">Lock dashboard</button></div>\n    </aside>\n    <main class=\"main\">\n      <header class=\"topbar\"><div><span class=\"eyebrow\">CLOUDEMPIRE / ADMIN</span><h1 id=\"page-title\">Overview</h1></div><span class=\"status\" id=\"connection\">Sign in required</span></header>\n      <section id=\"signin\" class=\"signin card\">\n        <span class=\"eyebrow\">SECURE ACCESS</span><h2>Welcome back.</h2>\n        <p>Sign in to manage CloudEmpire content, inquiries, and analytics.</p>\n        <form id=\"login-form\"><label for=\"login-email\">Email</label><input id=\"login-email\" type=\"email\" autocomplete=\"username\" required><label for=\"login-password\">Password</label><input id=\"login-password\" type=\"password\" autocomplete=\"current-password\" required><button id=\"login\" class=\"primary auth-button\" type=\"submit\">Sign in</button></form>\n      </section>\n      <section id=\"bootstrap\" class=\"signin card\" hidden>\n        <span class=\"eyebrow\">ONE-TIME SETUP</span><h2>Create your admin login.</h2>\n        <p>Choose an email and password to manage your live MySQL content.</p>\n        <form id=\"bootstrap-form\"><label for=\"setup-email\">Admin email</label><input id=\"setup-email\" type=\"email\" autocomplete=\"username\" required><label for=\"setup-password\">New password</label><input id=\"setup-password\" type=\"password\" autocomplete=\"new-password\" minlength=\"12\" required><label for=\"setup-confirm\">Confirm password</label><input id=\"setup-confirm\" type=\"password\" autocomplete=\"new-password\" minlength=\"12\" required><button class=\"primary auth-button\" type=\"submit\">Create admin account</button></form>\n      </section>\n      <section id=\"invite\" class=\"signin card\" hidden><span class=\"eyebrow\">ADMIN INVITATION</span><h2>Join CloudEmpire.</h2><p>Create your own password to accept this one time invitation. It expires after seven days.</p><form id=\"invite-form\"><label for=\"invite-password\">New password</label><input id=\"invite-password\" type=\"password\" autocomplete=\"new-password\" minlength=\"12\" required><label for=\"invite-confirm\">Confirm password</label><input id=\"invite-confirm\" type=\"password\" autocomplete=\"new-password\" minlength=\"12\" required><button class=\"primary auth-button\" type=\"submit\">Accept invitation</button></form></section>\n      <div id=\"workspace\" hidden>\n        <div id=\"notice\" class=\"notice\" role=\"status\" hidden></div>\n        <section id=\"overview\" class=\"panel active\"><div class=\"intro\"><h2>Your site at a glance.</h2><p>Live content and the last 30 days of activity from Hostinger MySQL.</p></div><div class=\"summary-grid dashboard-grid\" id=\"summary\"></div><div class=\"dashboard-columns\"><div class=\"card\"><h3>Visits over the last 30 days</h3><div id=\"overview-trend\" class=\"trend-chart\"></div></div><div class=\"card\"><h3>Recent inquiries</h3><div id=\"overview-inquiries\"></div></div></div><div class=\"card dashboard-content\"><h3>Live content</h3><div id=\"overview-content\"></div></div></section>\n        <section id=\"editor-panel\" class=\"panel\"><div class=\"editor-layout\"><div class=\"card list-card\"><div class=\"list-head\"><h2 id=\"list-title\"></h2><button id=\"add-item\" class=\"small-primary\" type=\"button\">+ New</button></div><div id=\"item-list\" class=\"item-list\"></div></div><div class=\"card form-card\"><div class=\"form-head\"><div><span class=\"eyebrow\" id=\"form-kicker\">EDIT CONTENT</span><h2 id=\"form-title\">Select an item</h2></div><button id=\"delete-item\" class=\"quiet danger\" type=\"button\" hidden>Delete</button></div><form id=\"content-form\"><div id=\"fields\"></div><div class=\"form-actions\"><button class=\"primary\" type=\"submit\">Save changes</button><span id=\"form-hint\">Changes appear on the live site immediately.</span></div></form></div></div></section>\n        <section id=\"messages\" class=\"panel\"><div class=\"intro\"><h2>Inquiries</h2><p>Contact form submissions saved on the Hostinger server. Visitors still finish sending their message in WhatsApp.</p></div><div class=\"card\" id=\"messages-content\">Loading…</div></section>\n        <section id=\"analytics\" class=\"panel\"><div class=\"intro\"><h2>Site activity</h2><p>Privacy-friendly page view counts from the last 30 days. No IP addresses or cookies are stored for analytics.</p></div><div class=\"summary-grid\" id=\"analytics-cards\"></div><div class=\"card\"><h3>Popular pages</h3><div id=\"analytics-pages\"></div></div></section>\n        <section id=\"utm\" class=\"panel\"><div class=\"intro\"><h2>UTM campaign analysis.</h2><p>Tagged landing visits in the last 30 days. Links without UTM parameters appear in general Analytics.</p></div><div class=\"summary-grid\" id=\"utm-cards\"></div><div class=\"dashboard-columns\"><div class=\"card\"><h3>Sources</h3><div id=\"utm-sources\"></div></div><div class=\"card\"><h3>Mediums</h3><div id=\"utm-mediums\"></div></div></div><div class=\"card\"><h3>Campaigns</h3><div id=\"utm-campaigns\"></div></div><div class=\"dashboard-columns\"><div class=\"card\"><h3>Landing pages</h3><div id=\"utm-landings\"></div></div><div class=\"card\"><h3>Tagged visits by day</h3><div id=\"utm-trend\" class=\"trend-chart\"></div></div></div><div class=\"card\"><h3>Build a tagged link</h3><form id=\"utm-builder\" class=\"utm-builder\"><label>Destination path<input name=\"path\" value=\"/\" required></label><label>Source<input name=\"source\" placeholder=\"instagram\" required></label><label>Medium<input name=\"medium\" placeholder=\"social\" required></label><label>Campaign<input name=\"campaign\" placeholder=\"autumn-launch\" required></label><button class=\"primary\" type=\"submit\">Generate link</button></form><output id=\"utm-link\"></output></div></section>\n        <section id=\"database\" class=\"panel\"><div class=\"intro\"><h2>Database & media.</h2><p>Check live MySQL content, stored images, inquiries, and visit records. This page is for storage health and media management.</p></div><div class=\"summary-grid dashboard-grid\" id=\"storage-summary\"></div><div class=\"card\"><h3>Recent uploads</h3><form id=\"media-form\" class=\"media-upload\"><input id=\"media-file\" type=\"file\" accept=\"image/png,image/jpeg,image/webp\" required><button class=\"primary\" type=\"submit\">Upload image</button></form><p class=\"hint\">Copy an image path to use it in a blog post. Uploads are stored in Hostinger storage and indexed in MySQL.</p><div id=\"media-list\" class=\"media-list\"></div></div><details class=\"card connection-details\"><summary>Database connection settings</summary><p id=\"database-status\">Checking connection…</p><p>Database and user: <strong>u769677815_cloudempiredb</strong></p><form id=\"database-form\"><label for=\"database-password\">MySQL user password (for a planned rotation)</label><div class=\"login-row\"><input id=\"database-password\" type=\"password\" autocomplete=\"new-password\" required placeholder=\"Enter new MySQL password\"><button class=\"primary\" type=\"submit\">Update connection</button></div></form><p class=\"hint\">Use this only when rotating the MySQL password. The setting is stored outside public_html.</p></details></section>\n        <section id=\"users\" class=\"panel\"><div class=\"intro\"><h2>Admin users.</h2><p>Invite an editor to manage site content. Only the account owner can invite or remove admins.</p></div><div class=\"card\"><h3>Invite an admin</h3><form id=\"user-invite-form\" class=\"invite-row\"><label for=\"invite-email\">Email address</label><div class=\"login-row\"><input id=\"invite-email\" type=\"email\" autocomplete=\"off\" required placeholder=\"editor@example.com\"><button class=\"primary\" type=\"submit\">Create invitation</button></div></form><div id=\"invite-link-box\" hidden><p>Copy this one time link and share it privately. It expires in seven days.</p><div class=\"login-row\"><input id=\"invite-link\" type=\"text\" readonly aria-label=\"Invitation link\"><button id=\"copy-invite-link\" class=\"primary\" type=\"button\">Copy link</button></div></div></div><div class=\"dashboard-columns\"><div class=\"card\"><h3>Active admins</h3><div id=\"users-list\"></div></div><div class=\"card\"><h3>Pending invitations</h3><div id=\"invites-list\"></div></div></div></section>\n        <section id=\"files\" class=\"panel\"><div class=\"intro\"><h2>Site copy</h2><p>Edit homepage and footer messages stored in MySQL.</p></div><div class=\"card form-card\"><form id=\"site-copy-form\"></form></div></section>\n      </div>\n    </main>\n  </div>\n  "},"__N_SSG":true}