RewriteEngine On
RewriteCond %{QUERY_STRING} ^slug=([a-z0-9-]+)(?:&.*)?$ [NC]
RewriteRule ^service-details\.php$ https://cloudempire.tech/services/%1/? [R=301,L,NC]
RewriteCond %{QUERY_STRING} ^slug=([a-z0-9-]+)(?:&.*)?$ [NC]
RewriteRule ^blog-details\.php$ https://cloudempire.tech/blog/%1/? [R=301,L,NC]
RewriteRule ^(index\.php|app\.html)$ https://cloudempire.tech/ [R=301,L,NC]
RewriteRule ^(service\.php|services\.php)$ https://cloudempire.tech/services/ [R=301,L,NC]
RewriteRule ^about-us\.php$ https://cloudempire.tech/about/ [R=301,L,NC]
RewriteRule ^portfolio\.php$ https://cloudempire.tech/work/ [R=301,L,NC]
RewriteRule ^(contact-us\.php|contact\.php)$ https://cloudempire.tech/contact/ [R=301,L,NC]
RewriteRule ^(blog\.php|blogs\.php)$ https://cloudempire.tech/blog/ [R=301,L,NC]
RewriteCond %{HTTP_HOST} ^www\.cloudempire\.tech$ [NC]
RewriteRule ^(.*)$ https://cloudempire.tech/$1 [R=301,L,NE]
RewriteRule ^(about|services|work|process|blog|contact)$ https://cloudempire.tech/$1/ [R=301,L,NC]
RewriteRule ^(services|blog)/([a-z0-9-]+)$ https://cloudempire.tech/$1/$2/ [R=301,L,NC]
RewriteRule ^sitemap\.xml$ sitemap.php [L,QSA]
RewriteRule ^(api|admin|_next)/ - [L]
RewriteRule \.(js|css|png|jpe?g|webp|gif|svg|ico|woff2?|txt|json|map)$ - [L,NC]
RewriteRule ^(index\.html|app\.html)?$ site.php [L,QSA]
RewriteRule ^(about|services|work|process|blog|contact)(/.*)?$ site.php [L,QSA]
